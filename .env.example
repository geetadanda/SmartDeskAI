# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Initial SmartHR admin account (used only when the local account database is empty)
SMART_HR_ADMIN_USERNAME=
SMART_HR_ADMIN_PASSWORD=

# Optional: Specify OpenAI model versions
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Jira Cloud issue creation
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-account-email
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=YOURPROJECT
JIRA_ISSUE_TYPE=Task
# Optional mapping from helpdesk priorities to priorities configured in Jira
JIRA_PRIORITY_MAP={"Urgent":"Highest","High":"High","Medium":"Medium","Low":"Low"}
